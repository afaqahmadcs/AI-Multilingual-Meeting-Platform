# ==============================================================================
# LinguaMeet Environment Variables Template
# Copy this file to .env.local (in apps/web) and .env (in apps/mobile) as needed.
# NEVER commit your actual API keys or secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication & Database)
# Obtain these from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# LiveKit Configuration (Audio / Video / Screen Share WebRTC SFU)
# Obtain these from LiveKit Cloud dashboard or your self-hosted LiveKit instance
# ------------------------------------------------------------------------------
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_LIVEKIT_URL=wss://your-subdomain.livekit.cloud

# ------------------------------------------------------------------------------
# AI Translation Providers (Replaceable Adapter Configuration)
# Choose your active provider in packages/ai-translator or use multi-provider combo
# ------------------------------------------------------------------------------
# Primary: OpenAI (Whisper STT + GPT-4o-mini MT)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Urdu Neural Voice: Microsoft Azure Speech Services (Best for ur-PK TTS)
# Free F0 tier provides 5 hours STT + 0.5M characters neural TTS per month
AZURE_SPEECH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_SPEECH_REGION=eastus

# Alternative: Google Cloud Speech & Translation
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=

# Dev / PoC Mode: set to "mock" to test pipeline without consuming API credits
AI_TRANSLATOR_MODE=mock
